# Database Configuration
DATABASE_URL=postgresql+psycopg://sessions:your-password-here@localhost:5432/sessions

# Redis Configuration  
REDIS_URL=redis://localhost:6379

# Application Settings
DEBUG=false
CORS_ORIGINS=http://localhost:4321,http://localhost:4324,http://localhost:3001,http://localhost:8000,http://localhost:4173,https://sessions.tuhuratech.org.nz,https://sessions-admin.tuhuratech.org.nz
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:4324
ADMIN_BASE_URL=http://localhost:3001

# Authentication & Security
AUTH_SECRET=your-secret-key-change-me-in-production
MAGIC_LINK_TTL_MINUTES=15
CAREGIVER_SESSION_TTL_DAYS=30

# Admin Authentication
ADMIN_SESSION_TTL_HOURS=24

# Admin OAuth (Google)
ADMIN_GOOGLE_OAUTH_CLIENT_ID=
ADMIN_GOOGLE_OAUTH_CLIENT_SECRET=

# Email Configuration
EMAIL_FROM=noreply@tuhuratech.org.nz
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Background Workers
SAQ_WEB_ENABLED=true
SAQ_CONCURRENCY=10
