# Database Configuration
DATABASE_URL=postgresql+psycopg://sessions:your-password-here@localhost:5432/sessions

# Redis Configuration  
REDIS_URL=redis://localhost:6379

# Application Settings
DEBUG=false
CORS_ORIGINS=http://localhost:4321,http://localhost:4324,http://localhost:3001,http://localhost:8000,http://localhost:4173,https://sessions.tuhuratech.org.nz,https://sessions-admin.tuhuratech.org.nz
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:4324
ADMIN_BASE_URL=http://localhost:3001

# Authentication & Security
AUTH_SECRET=your-secret-key-change-me-in-production
MAGIC_LINK_TTL_MINUTES=15
CAREGIVER_SESSION_TTL_DAYS=30

# Admin Authentication
ADMIN_SESSION_TTL_HOURS=24

# Admin OAuth (Google)
ADMIN_GOOGLE_OAUTH_CLIENT_ID=
ADMIN_GOOGLE_OAUTH_CLIENT_SECRET=

# Email Configuration (Mailgun)
# In development: Leave EMAIL_DRY_RUN=true to log emails instead of sending
# In production: Set EMAIL_DRY_RUN=false and configure Mailgun credentials
EMAIL_DRY_RUN=true
EMAIL_FROM=noreply@tuhuratech.org.nz
EMAIL_FROM_NAME=Tūhura Tech
EMAIL_CONTACT=support@tuhuratech.org.nz

# Mailgun API credentials (required for production email sending)
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=mg.tuhuratech.org.nz
MAILGUN_API_URL=https://api.mailgun.net/v3

# Background Workers
SAQ_WEB_ENABLED=true
SAQ_CONCURRENCY=10
