---
import type { ApiCaregiverSignup, ApiChild } from '../lib/api';

interface Props {
	child: ApiChild;
	signups: ApiCaregiverSignup[];
}

const { child, signups } = Astro.props;

// Find signups for this child
const childSignups = signups.filter((signup) => signup.childId === child.id);
---

<div class="rounded-lg border border-gray-200 bg-white p-4">
	<div class="flex items-start justify-between">
		<div class="flex-1">
			<p class="font-semibold text-gray-900">{child.name}</p>
			{
				child.dateOfBirth && (
					<p class="text-sm text-gray-600">
						Born: {new Date(child.dateOfBirth).toLocaleDateString('en-NZ')}
					</p>
				)
			}

			{
				childSignups.length > 0 ? (
					<div class="mt-3 space-y-2">
						<p class="text-sm font-medium text-gray-700">Signed up for:</p>
						{childSignups.map((signup) => (
							<div class="flex items-center gap-2 rounded-md bg-tuhura-green/10 px-3 py-2">
								<svg class="h-4 w-4 text-tuhura-green" fill="currentColor" viewBox="0 0 20 20">
									<path
										fill-rule="evenodd"
										d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
										clip-rule="evenodd"
									/>
								</svg>
								<div class="flex-1">
									<p class="text-sm text-gray-900">{signup.sessionName}</p>
									<p class="text-xs text-gray-600 capitalize">{signup.status}</p>
								</div>
								<a
									href={`/sessions/${signup.sessionId}`}
									class="text-xs font-semibold text-tuhura-green hover:text-tuhura-green/80"
								>
									View session
								</a>
							</div>
						))}
					</div>
				) : (
					<div class="mt-3 rounded-md bg-amber-50 px-3 py-2">
						<p class="text-sm text-amber-800">Not signed up for any sessions</p>
					</div>
				)
			}
		</div>
		<button
			class="text-sm text-tuhura-green hover:text-tuhura-green/80"
			data-child-id={child.id}
			data-child-name={child.name}
			data-child-dob={child.dateOfBirth ?? ''}
		>
			Edit
		</button>
	</div>
</div>
