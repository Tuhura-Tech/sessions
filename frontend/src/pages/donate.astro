---
import DonateModal from '../components/DonateModal.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Donate to Tūhura Tech">
	<main class="bg-gradient-to-b from-blue-50 to-white py-12 md:py-20">
		<div class="container-custom">
			<div class="mx-auto max-w-3xl">
				<!-- Header -->
				<div class="text-center">
					<h1 class="text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
						Support Our Mission
					</h1>
					<p class="mt-4 text-xl text-gray-600">
						Help us empower the next generation through industry-supported Technology Education.
					</p>
				</div>

				<!-- Donation Info Cards -->
				<div class="mt-12 grid gap-8 md:grid-cols-2">
					<div class="rounded-lg bg-white p-6 shadow-md">
						<div class="text-3xl font-bold text-blue-600">2000+</div>
						<p class="mt-2 text-gray-600">Students engaged annually</p>
					</div>

					<div class="rounded-lg bg-white p-6 shadow-md">
						<div class="text-3xl font-bold text-blue-600">100%</div>
						<p class="mt-2 text-gray-600">Free for students</p>
					</div>
				</div>

				<!-- Impact Section -->
				<div class="mt-12 rounded-lg bg-blue-50 p-8">
					<h2 class="text-2xl font-bold text-gray-900">Your Koha Makes a Difference</h2>
					<div class="mt-6 space-y-4 text-gray-700">
						<p>
							<strong>$20</strong> sponsors a student for a session
						</p>
						<p>
							<strong>$200</strong> sponsors a student to attend for a term
						</p>
						<p>
							<strong>$800</strong> sponsors a student to attend for a year
						</p>
					</div>
				</div>
				<div class="mt-12 rounded-lg border border-gray-200 bg-white p-8 shadow-sm">
					<h2 class="mb-6 text-center text-2xl font-bold text-gray-900">Make a koha</h2>
					<div
						class="raisely-donate"
						data-campaign-path="tuhura-tech"
						data-profile=""
						data-width="100%"
						data-height="700"
					>
					</div>
				</div>

				<!-- FAQ Section -->
				<div class="mt-16">
					<h2 class="text-2xl font-bold text-gray-900">Frequently Asked Questions</h2>
					<div class="mt-8 space-y-6">
						<details class="rounded-lg border border-gray-200 p-6">
							<summary class="cursor-pointer font-semibold text-gray-900">
								Is my donation tax-deductible?
							</summary>
							<p class="mt-4 text-gray-700">
								Yes! Tūhura Tech is a registered charitable organization in New Zealand. You will
								receive a tax receipt with your donation.
							</p>
						</details>

						<details class="rounded-lg border border-gray-200 p-6">
							<summary class="cursor-pointer font-semibold text-gray-900">
								How are donations used?
							</summary>
							<p class="mt-4 text-gray-700">
								Your donation supports student scholarships, workshop materials, facility costs, and
								instructor training. We believe in transparency and are happy to share detailed
								impact reports upon request.
							</p>
						</details>

						<details class="rounded-lg border border-gray-200 p-6">
							<summary class="cursor-pointer font-semibold text-gray-900">
								Can I donate a different amount?
							</summary>
							<p class="mt-4 text-gray-700">
								Absolutely! Click "Make a Donation" above to choose your own amount. Every
								contribution helps.
							</p>
						</details>

						<details class="rounded-lg border border-gray-200 p-6">
							<summary class="cursor-pointer font-semibold text-gray-900">
								Can I set up a recurring donation?
							</summary>
							<p class="mt-4 text-gray-700">
								Yes! When you click "Make a Donation", you'll have the option to set up a monthly
								recurring gift. This helps us plan long-term programs.
							</p>
						</details>
					</div>
				</div>

				<!-- Contact -->
				<div class="mt-16 rounded-lg bg-gray-50 p-8 text-center">
					<h3 class="text-lg font-semibold text-gray-900">Questions About Donations?</h3>
					<p class="mt-2 text-gray-700">
						Contact us at <a
							href="mailto:support@tuhura.co.nz"
							class="text-blue-600 hover:underline">support@tuhuratech.org.nz</a
						>
					</p>
				</div>
			</div>
		</div>
	</main>
</Layout>

<!-- Always load the Raisely embed script -->
<script data-raisely-embed src="https://cdn.raisely.com/v3/public/embed.js" async></script>
